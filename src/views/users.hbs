<div class="container">
    <h1>{{title}}</h1>

    <table class="user-table">
        <thead>
            <tr>
                <th>№</th>
                <th>Имя пользователя</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
            <tr>
                <th>{{@index}}</th>
                <th>{{this.users}}</th>
                <th>{{this.email}}</th>
            </tr>
            {{else}}
            <tr>
                <td>Не найдено</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
<div><a href="/home"></a></div>
</div>