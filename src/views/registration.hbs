<div class="auth-wrapper">
    <div class="auth-card">
        <h2>Создать аккаунт</h2>

        {{#if error}}
            <div class="alert alert-error">{{error}}</div>
        {{/if}}

        <form action="/registration" method="POST" class="auth-form">
            <div class="form-group">
                <label for="username">Имя пользователя</label>
                <input type="text" name="username" id="username" required placeholder="Имя пользователя">
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" required placeholder="example@mail.com">
            </div>

            <div class="form-group">
                <label for="password">Пароль</label>
                <input type="password" name="password" id="password" required>
            </div>

            <div class="form-group">
                <label for="passConf">Подтвердите пароль</label>
                <input type="password" name="passConf" id="passConf" required>
            </div>

            <button type="submit" class="btn-primary">Зарегистрироваться</button>
        </form>

        <p class="auth-link">Уже есть аккаунт? <a href="/login">Войти</a></p>
    </div>
</div>